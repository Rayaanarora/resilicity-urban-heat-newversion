# Image generation: providers tried in order.
#   hf_space = free FLUX.1 Kontext Space on Hugging Face (default)
#   fal      = fal.ai FLUX.1 Kontext, pay per image (needs FAL_KEY)
#   gemini   = Google Gemini image editing (needs GEMINI_API_KEY)
IMAGE_PROVIDERS=hf_space,fal

# Optional free Hugging Face token (huggingface.co/settings/tokens): raises the Space GPU quota.
HF_TOKEN=
# Optional fal.ai key: paid fallback used only when the free Space fails or is out of quota.
FAL_KEY=
# GEMINI_API_KEY=

# 1 = serve cached redesigns only and never call a provider (for UI / demo work).
REDESIGN_OFFLINE=0
# Every generated redesign is stored here and reused for identical requests.
REDESIGN_CACHE_DIR=D:\Resillicity\cache\redesign
# Where Hugging Face model downloads (SegFormer, Depth Anything) are stored.
HF_HOME=D:\Resillicity\hf_cache
